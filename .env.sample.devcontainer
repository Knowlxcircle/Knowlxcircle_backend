# Ready-to-use values for the devcontainer. Copy to .env.
# Mirrors .env.sample; see that file for what each variable does.

DJANGO_DEBUG=True
DJANGO_SECRET_KEY=devcontainer-insecure-secret-key
DJANGO_ALLOWED_HOSTS=0.0.0.0
CSRF_TRUSTED_ORIGINS=
CORS_ALLOWED_ORIGINS=
DJANGO_LOG_LEVEL=DEBUG

# sqlite in the repo root; DATABASE_URL is ignored while this is True.
DEVELOPMENT_MODE=True
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app

CACHELOCATION=redis://redis:6379/0
REDIS_URL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5-mini

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v23.0
