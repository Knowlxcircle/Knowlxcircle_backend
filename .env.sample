# Copy to .env and fill in. Every variable below is read by
# knowlxcirclebackend/settings.py; nothing else is.

# --- Core Django -----------------------------------------------------------
# "True" turns on debug mode, the sqlite fallback and the insecure dev key.
DJANGO_DEBUG=False
# Required whenever DJANGO_DEBUG is False. DJANGO_API_KEY and SECRET_KEY are
# still honoured as legacy fallbacks (the CI workflow exports those).
DJANGO_SECRET_KEY=<django-secret-key>
# Comma separated, ADDED to the built-in 127.0.0.1 / localhost defaults.
DJANGO_ALLOWED_HOSTS=
# Comma separated, ADDED to the built-in trusted origins.
CSRF_TRUSTED_ORIGINS=
# Comma separated, ADDED to the built-in browser origins (Vite dev server and
# the deployed frontends are already included).
CORS_ALLOWED_ORIGINS=
# DEBUG / INFO / WARNING / ERROR / CRITICAL. Anything else falls back to INFO.
DJANGO_LOG_LEVEL=INFO

# --- Database --------------------------------------------------------------
# "True" forces the local sqlite database and ignores DATABASE_URL.
DEVELOPMENT_MODE=True
# Required when DEVELOPMENT_MODE is False and DJANGO_DEBUG is False.
# Driver is psycopg 3, e.g. postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- Cache -----------------------------------------------------------------
# Leave both empty to use the in-process LocMemCache.
CACHELOCATION=
REDIS_URL=

# --- Gemini ----------------------------------------------------------------
OPENROUTER_API_KEY=<openrouter-api-key>
OPENROUTER_MODEL=openai/gpt-5-mini

# --- Facebook social login (optional) --------------------------------------
# Both must be set for the provider APP entry to be configured at all.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_API_VERSION=v23.0

# --- Set by the platform, not by you ---------------------------------------
# Azure App Service exports WEBSITE_HOSTNAME; it is folded into ALLOWED_HOSTS,
# CSRF_TRUSTED_ORIGINS and CORS_ALLOWED_ORIGINS automatically.
# WEBSITE_HOSTNAME=
